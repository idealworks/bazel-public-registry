autoconf_hdr(
    name = "config_h",
    out = "src/config.h",
    template = "config.h.in",
    deps = [":config_checks"],
)

cc_library(
    name = "libgpg-error",
    srcs = [
        "src/argparse.c",
        "src/b64dec.c",
        "src/b64enc.c",
        "src/code-from-errno.c",
        "src/code-to-errno.c",
        "src/estream.c",
        "src/estream-printf.c",
        "src/init.c",
        "src/logging.c",
        "src/name-value.c",
        "src/posix-lock.c",
        "src/posix-thread.c",
        "src/spawn-posix.c",
        "src/strerror.c",
        "src/stringutils.c",
        "src/strlist.c",
        "src/strsource.c",
        "src/syscall-clamp.c",
        "src/sysutils.c",
        "src/version.c",
        "src/visibility.c",
    ],
    hdrs = [
        "src/estream-printf.h",
        "src/gettext.h",
        "src/gpgrt-int.h",
        "src/init.h",
        "src/lock.h",
        "src/posix-lock-obj.h",
        "src/protos.h",
        "src/thread.h",
        "src/visibility.h",
        ":config_h",
        ":gen_code_from_errno_h",
        ":gen_code_to_errno_h",
        ":gen_err_codes_h",
        ":gen_err_sources_h",
        ":gen_gpg_error_h",
        ":gen_gpgrt_h",
    ],
    copts = [
        "-DLOCALEDIR=\\\"/usr/share/locale\\\"",
        "-DSYSCONFDIR=\\\"/etc\\\"",
    ],
    includes = [
        "src",
    ],
    local_defines = [
        "HAVE_CONFIG_H",
        "_GNU_SOURCE",
        "_DEFAULT_SOURCE",
    ],
)
