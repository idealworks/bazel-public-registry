        ),
        checks.AC_CHECK_FUNC(
            "pthread_atfork",
            define = "HAVE_PTHREAD_ATFORK",
        ),
        checks.AC_CHECK_FUNC(
            "setenv",
            define = "HAVE_SETENV",
        ),
        checks.AC_CHECK_FUNC(
            "flockfile",
            define = "HAVE_FLOCKFILE",
        ),
        checks.AC_CHECK_FUNC(
