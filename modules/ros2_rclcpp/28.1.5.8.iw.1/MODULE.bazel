module(
    name = "ros2_rclcpp",
    version = "28.1.5.8.iw.1",
    compatibility_level = 1,
)

bazel_dep(name = "com_github_mvukov_rules_ros2", version = "2.0.0.eddy.1")
bazel_dep(name = "ros2_ament_index", version = "1.8.1.1.iw.1")
bazel_dep(name = "ros2_class_loader", version = "2.7.0.0.iw.1")
bazel_dep(name = "ros2_libstatistics_collector", version = "1.7.3.1.iw.1")
bazel_dep(name = "ros2_rcl", version = "9.2.4.1.iw.1")
bazel_dep(name = "ros2_rcl_interfaces", version = "2.0.2.1.iw.1")
bazel_dep(name = "ros2_rcpputils", version = "2.11.0.2.iw.1")
bazel_dep(name = "ros2_rcutils", version = "6.7.2.1.iw.1")
bazel_dep(name = "ros2_rmw", version = "7.3.1.1.iw.1")
bazel_dep(name = "ros2_rosidl", version = "4.6.4.3.iw.1")
bazel_dep(name = "ros2_rosidl_typesupport", version = "3.2.2.1.iw.1")
bazel_dep(name = "ros2_tracing", version = "8.2.2.1.iw.1")
