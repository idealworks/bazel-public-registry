module(
    name = "ros2_rmw_zenoh_cpp",
    version = "0.2.13.0.iw.1",
    compatibility_level = 1,
)

bazel_dep(name = "rules_cc", version = "0.2.28")

# Matches zenoh_cpp_vendor: rmw_zenoh 0.2.13 pins zenoh-c/zenoh-cpp 1.10.1 (+ fixes).
# Bump only alongside a matching rmw_zenoh release.
bazel_dep(name = "zenoh-cpp", version = "1.10.1")

# zenoh-c registers its Rust toolchain as a dev dependency only, so its users must.
bazel_dep(name = "rules_rs", version = "0.0.109")

rust_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
use_repo(rust_toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")
bazel_dep(name = "fast_cdr", version = "2.2.8.iw.0")
bazel_dep(name = "ros2_ament_index", version = "1.8.4.0.iw.0")
bazel_dep(name = "ros2_rcutils", version = "6.7.7.0.iw.0")
bazel_dep(name = "ros2_rcpputils", version = "2.11.4.0.iw.0")
bazel_dep(name = "ros2_rmw", version = "7.3.4.0.iw.0")
bazel_dep(name = "ros2_rosidl", version = "4.6.10.1.iw.0")
bazel_dep(name = "ros2_rosidl_dynamic_typesupport", version = "0.1.2.0.iw.0")
bazel_dep(name = "ros2_rosidl_typesupport_fastrtps", version = "3.6.4.0.iw.2")
bazel_dep(name = "ros2_tracing", version = "8.2.7.0.iw.0")
