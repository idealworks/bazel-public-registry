bazel_dep(name = "ros2_rosidl", version = "4.6.4.3.iw.2")
bazel_dep(name = "ros2_rosidl_dynamic_typesupport", version = "0.3.0.iw.jazzy.1")
bazel_dep(name = "ros2_rosidl_typesupport_fastrtps", version = "3.6.4.0.iw.1")
