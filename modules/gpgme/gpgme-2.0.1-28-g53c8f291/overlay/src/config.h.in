#ifndef GPGME_CONFIG_H
#define GPGME_CONFIG_H

#undef HAVE_STDINT_H
#undef HAVE_INTTYPES_H
#undef HAVE_SYS_TYPES_H
#undef HAVE_SYS_STAT_H
#undef HAVE_UNISTD_H
#undef HAVE_LOCALE_H
#undef HAVE_SYS_TIME_H
#undef HAVE_SYS_SELECT_H
#undef HAVE_SYS_UIO_H
#undef HAVE_FCNTL_H
#undef HAVE_POLL_H

#undef HAVE_FSEEKO
#undef HAVE_STPCPY
#undef HAVE_TIMEGM
#undef HAVE_SETLOCALE
#undef HAVE_NANOSLEEP
#undef HAVE_GETGID
#undef HAVE_GETEGID
#undef HAVE_CLOSEFROM
#undef HAVE_GETENV
#undef HAVE_SETENV
#undef HAVE_TTYNAME_R
#undef HAVE_GETENV_R

#define PACKAGE "gpgme"
#define PACKAGE_NAME "gpgme"
#define PACKAGE_VERSION "2.0.1"
#define VERSION "2.0.1"
#define BUILD_REVISION "53c8f291"
#define BUILD_COMMITID "53c8f29125ff9664120879b78fb11a6e766f89f4"
#define BUILD_TIMESTAMP "<none>"

#define HAVE_CONFIG_H 1
#define _REENTRANT 1
#define USE_DESCRIPTOR_PASSING 1
#define ENABLE_UISERVER 1
#define USE_LINUX_GETDENTS 1
#define HAVE_TLS 1
#define FLEXIBLE_ARRAY_MEMBER

#define GPG_ERR_SOURCE_DEFAULT GPG_ERR_SOURCE_GPGME
#define GPG_ERR_ENABLE_GETTEXT_MACROS 1
#define GPGRT_ENABLE_ES_MACROS 1
#define GPGRT_ENABLE_LOG_MACROS 1
#define GPGRT_ENABLE_ARGPARSE_MACROS 1

#define SIZEOF_UNSIGNED_INT 4
#define SIZEOF_UNSIGNED_LONG 8
#define SIZEOF_VOID_P 8

#ifdef HAVE_DOSISH_SYSTEM
#define PATHSEP_C ';'
#define DIRSEP_C '\\'
#define DIRSEP_S "\\"
#else
#define PATHSEP_C ':'
#define DIRSEP_C '/'
#define DIRSEP_S "/"
#endif

#if __GNUC__ > 2
#define GPGME_GCC_A_PURE __attribute__((__pure__))
#else
