load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc_autoconf//autoconf:autoconf.bzl", "autoconf")
load("@rules_cc_autoconf//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("@rules_cc_autoconf//autoconf:checks.bzl", "checks")

GPGME_VERSION = module_version().split("-", 1)[0]

expand_template(
    name = "gen_gpgme_h",
    out = "src/gpgme.h",
    substitutions = {
        "@GPGME_CONFIG_HOST@": "linux-gnu",
        "@PACKAGE_VERSION@": GPGME_VERSION,
        "@VERSION_NUMBER@": "0x020001",
        "@INSERT__TYPEDEFS_FOR_GPGME_H@": "\n#include <sys/types.h>\ntypedef off_t   gpgme_off_t;\ntypedef ssize_t gpgme_ssize_t;",
        "@NEED__FILE_OFFSET_BITS@": "0",
        "@API__SSIZE_T@": "ssize_t",
        "@API__OFF_T@": "off_t",
        "@emacs_local_vars_begin@": "Local Variables:",
        "@emacs_local_vars_read_only@": "buffer-read-only: t",
        "@emacs_local_vars_end@": "End:",
    },
    template = "src/gpgme.h.in",
    visibility = ["//visibility:public"],
)

autoconf(
    name = "config_checks",
    checks = [
        checks.AC_CHECK_HEADER(
            "stdint.h",
            define = "HAVE_STDINT_H",
        ),
        checks.AC_CHECK_HEADER(
            "inttypes.h",
            define = "HAVE_INTTYPES_H",
        ),
        checks.AC_CHECK_HEADER(
            "sys/types.h",
            define = "HAVE_SYS_TYPES_H",
        ),
        checks.AC_CHECK_HEADER(
            "sys/stat.h",
            define = "HAVE_SYS_STAT_H",
        ),
        checks.AC_CHECK_HEADER(
            "unistd.h",
            define = "HAVE_UNISTD_H",
        ),
        checks.AC_CHECK_HEADER(
            "locale.h",
            define = "HAVE_LOCALE_H",
        ),
        checks.AC_CHECK_HEADER(
            "sys/time.h",
            define = "HAVE_SYS_TIME_H",
        ),
        checks.AC_CHECK_HEADER(
            "sys/select.h",
            define = "HAVE_SYS_SELECT_H",
        ),
        checks.AC_CHECK_HEADER(
            "sys/uio.h",
            define = "HAVE_SYS_UIO_H",
        ),
        checks.AC_CHECK_HEADER(
            "fcntl.h",
            define = "HAVE_FCNTL_H",
        ),
        checks.AC_CHECK_HEADER(
            "poll.h",
            define = "HAVE_POLL_H",
        ),
        checks.AC_CHECK_FUNC(
            "fseeko",
            define = "HAVE_FSEEKO",
        ),
        checks.AC_CHECK_FUNC(
            "stpcpy",
            define = "HAVE_STPCPY",
        ),
        checks.AC_CHECK_FUNC(
            "timegm",
            define = "HAVE_TIMEGM",
        ),
        checks.AC_CHECK_FUNC(
            "setlocale",
            define = "HAVE_SETLOCALE",
        ),
        checks.AC_CHECK_FUNC(
            "nanosleep",
            define = "HAVE_NANOSLEEP",
        ),
        checks.AC_CHECK_FUNC(
            "getgid",
            define = "HAVE_GETGID",
        ),
        checks.AC_CHECK_FUNC(
            "getegid",
            define = "HAVE_GETEGID",
        ),
        checks.AC_CHECK_FUNC(
            "closefrom",
            define = "HAVE_CLOSEFROM",
        ),
        checks.AC_CHECK_FUNC(
            "getenv",
            define = "HAVE_GETENV",
        ),
        checks.AC_CHECK_FUNC(
            "setenv",
            define = "HAVE_SETENV",
        ),
        checks.AC_CHECK_FUNC(
            "ttyname_r",
            define = "HAVE_TTYNAME_R",
        ),
        checks.AC_CHECK_FUNC(
            "getenv_r",
            define = "HAVE_GETENV_R",
        ),
    ],
)

autoconf_hdr(
    name = "config_h",
    out = "conf/config.h",
    template = "src/config.h.in",
    deps = [":config_checks"],
)

cc_library(
    name = "gpgme",
    srcs = [
        "src/assuan-support.c",
        "src/context.h",
        "src/conversion.c",
        "src/data.c",
        "src/data.h",
        "src/data-compat.c",
        "src/data-estream.c",
        "src/data-fd.c",
        "src/data-identify.c",
        "src/data-mem.c",
        "src/data-stream.c",
        "src/data-user.c",
        "src/debug.c",
        "src/debug.h",
        "src/decrypt.c",
        "src/decrypt-verify.c",
        "src/delete.c",
        "src/dirinfo.c",
        "src/edit.c",
        "src/encrypt.c",
        "src/encrypt-sign.c",
        "src/engine.c",
        "src/engine.h",
        "src/engine-assuan.c",
        "src/engine-backend.h",
        "src/engine-g13.c",
        "src/engine-gpg.c",
        "src/engine-gpgconf.c",
        "src/engine-gpgsm.c",
        "src/engine-spawn.c",
        "src/engine-uiserver.c",
        "src/error.c",
        "src/export.c",
        "src/genkey.c",
        "src/genrandom.c",
        "src/get-env.c",
        "src/getauditlog.c",
        "src/gpgconf.c",
        "src/gpgme.c",
        "src/import.c",
        "src/key.c",
        "src/keylist.c",
        "src/keysign.c",
        "src/mbox-util.c",
        "src/mbox-util.h",
        "src/op-support.c",
        "src/opassuan.c",
        "src/ops.h",
        "src/parsetlv.c",
        "src/parsetlv.h",
        "src/passphrase.c",
        "src/passwd.c",
        "src/posix-io.c",
        "src/posix-util.c",
        "src/priv-io.h",
        "src/progress.c",
        "src/queryswdb.c",
        "src/revsig.c",
        "src/sema.h",
        "src/setexpire.c",
        "src/setownertrust.c",
        "src/sig-notation.c",
        "src/sign.c",
        "src/signers.c",
        "src/spawn.c",
        "src/status-table.c",
        "src/sys-util.h",
        "src/tofupolicy.c",
        "src/util.h",
        "src/verify.c",
        "src/version.c",
        "src/vfs-create.c",
        "src/vfs-mount.c",
        "src/wait.c",
        "src/wait.h",
        "src/wait-global.c",
        "src/wait-private.c",
        "src/wait-user.c",
    ],
    hdrs = [
        ":config_h",
        ":gen_gpgme_h",
    ],
    copts = ["-std=gnu11"],
    includes = [
        "conf",
        "src",
    ],
    linkopts = ["-lpthread"],
    local_defines = ["HAVE_CONFIG_H"],
    visibility = ["//visibility:public"],
    deps = [
        "@libassuan",
        "@libgpg-error",
    ],
)
