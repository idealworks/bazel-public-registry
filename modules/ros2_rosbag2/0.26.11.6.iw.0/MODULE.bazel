module(
    name = "ros2_rosbag2",
    version = "0.26.11.6.iw.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_ros2_interfaces", version = "0.1.0")
bazel_dep(name = "com_github_mvukov_rules_ros2", version = "2.0.0.eddy.10")
bazel_dep(name = "mcap", version = "2.1.3")  # 1.x lacks <cstdint> (GCC 15); rolling made the same move with no source changes
bazel_dep(name = "pybind11_bazel", version = "3.0.3")

# pybind11 headers from BCR (pybind11_bazel 3.0.3 ships pybind11 3.0)
pybind_configure = use_extension("@pybind11_bazel//:internal_configure.bzl", "internal_configure_extension")
use_repo(pybind_configure, "pybind11")

bazel_dep(name = "readerwriterqueue", version = "1.0.7")
bazel_dep(name = "ros2_keyboard_handler", version = "0.3.2.0.iw.0")
bazel_dep(name = "ros2_pluginlib", version = "5.4.6.1.iw.0")
bazel_dep(name = "ros2_rcl_interfaces", version = "2.0.4.0.iw.0")
bazel_dep(name = "ros2_rclcpp", version = "28.1.23.0.iw.0")
bazel_dep(name = "ros2_rcpputils", version = "2.11.4.0.iw.0")
bazel_dep(name = "ros2_rcutils", version = "6.7.7.0.iw.0")
bazel_dep(name = "ros2_rmw", version = "7.3.4.0.iw.0")
bazel_dep(name = "ros2_rmw_implementation", version = "2.15.7.0.iw.1")
bazel_dep(name = "ros2_rosidl", version = "4.6.10.1.iw.0")
bazel_dep(name = "ros2_rosidl_typesupport", version = "3.2.3.0.iw.0")
bazel_dep(name = "ros2_rpyutils", version = "0.4.2.0.iw.0")
bazel_dep(name = "ros2cli", version = "0.32.14.1.iw.1")
bazel_dep(name = "rules_python", version = "2.5.0")
bazel_dep(name = "sqlite3", version = "3.53.4")
bazel_dep(name = "yaml-cpp", version = "0.9.0.bcr.1")
bazel_dep(name = "zstd", version = "1.5.7.bcr.3")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "ros2_rosbag2_pip_deps",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "ros2_rosbag2_pip_deps")
