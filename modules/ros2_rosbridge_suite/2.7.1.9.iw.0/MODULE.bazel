module(
    name = "ros2_rosbridge_suite",
    version = "2.7.1.9.iw.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_ros2_interfaces", version = "0.1.0")
bazel_dep(name = "com_github_mvukov_rules_ros2", version = "2.0.0.eddy.10")
bazel_dep(name = "ros2_rclpy", version = "7.1.13.0.iw.1")
bazel_dep(name = "ros2_rosidl", version = "4.6.10.1.iw.0")
bazel_dep(name = "ros2_common_interfaces", version = "5.3.8.0.iw.0")
bazel_dep(name = "ros2_rcl_interfaces", version = "2.0.4.0.iw.0")
bazel_dep(name = "rules_python", version = "2.5.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    configure_coverage_tool = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "rosbridge_suite_pip_deps",
    python_version = "3.12",
    requirements_lock = "//third_party:requirements_lock.txt",
    target_platforms = [
        "linux_x86_64",
        "linux_aarch64",
    ],
)
use_repo(pip, "rosbridge_suite_pip_deps")
