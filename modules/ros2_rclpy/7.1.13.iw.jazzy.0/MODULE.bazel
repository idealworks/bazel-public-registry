module(
    name = "ros2_rclpy",
    version = "7.1.13.iw.jazzy.0",
    compatibility_level = 1,
)

bazel_dep(name = "pybind11", version = "2.13.6.iw.1")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "ros2_ament_index", version = "1.8.4.iw.jazzy.0")
