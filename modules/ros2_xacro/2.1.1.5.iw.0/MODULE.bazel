module(
    name = "ros2_xacro",
    version = "2.1.1.5.iw.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_python", version = "2.5.0")
bazel_dep(name = "ros2_ament_index", version = "1.8.4.0.iw.0")

# upstream's root BUILD.bazel needs this hub; its lock file ships in bazel/
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "xacro_python_dependencies",
    python_version = "3.12",
    requirements_lock = "//bazel:requirements_lock.txt",
)
use_repo(pip, "xacro_python_dependencies")
