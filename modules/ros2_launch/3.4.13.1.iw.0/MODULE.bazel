module(
    name = "ros2_launch",
    version = "3.4.13.1.iw.0",
    compatibility_level = 1,
)

bazel_dep(name = "osrf_pycommon", version = "2.1.4.6.iw.1")
bazel_dep(name = "ros2_ament_index", version = "1.8.4.0.iw.0")
bazel_dep(name = "rules_python", version = "2.5.0")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "ros2_launch_pip_deps",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "ros2_launch_pip_deps")
