module(
    name = "ros2_rcutils",
    version = "6.7.7.0.iw.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "2.5.0")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "google_benchmark", version = "1.10.0")
bazel_dep(name = "ros2_osrf_testing_tools_cpp", version = "2.0.0.0.iw.2")
bazel_dep(name = "mimick", version = "0.9.0.bcr.0")

python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
)
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "ros2_rcutils_pip_deps",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
    target_platforms = [
        "linux_x86_64",
        "linux_aarch64",
    ],
)
use_repo(pip, "ros2_rcutils_pip_deps")
