module(
    name = "foxglove_bridge",
    version = "0.8.5.0.iw.0",
)

# websocketpp 0.8.2.bcr.3 pins asio 1.28.2, whose BUILD has no rules_cc load (Bazel 9+); asio 1.33+ drops io_service, which websocketpp 0.8.2 uses
bazel_dep(name = "asio", version = "1.32.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")
bazel_dep(name = "ros2_rcl_interfaces", version = "2.0.4.0.iw.0")
bazel_dep(name = "ros2_rclcpp", version = "28.1.23.0.iw.0")
bazel_dep(name = "ros2_resource_retriever", version = "3.4.4.0.iw.0")
bazel_dep(name = "ros2_rosx_introspection", version = "3.1.3.0.iw.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
# websocketpp 0.8.2.bcr.4+ pulls boost.asio >= 1.87, which removed the Asio API sick_safetyscanners_base and pcl still use
bazel_dep(name = "websocketpp", version = "0.8.2.bcr.3")
