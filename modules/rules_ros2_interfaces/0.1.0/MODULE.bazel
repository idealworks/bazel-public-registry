module(
    name = "rules_ros2_interfaces",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_python", version = "2.5.0")
bazel_dep(name = "ros2_rosidl", version = "4.6.10.1.iw.0")
bazel_dep(name = "ros2_rosidl_python", version = "0.22.2.0.iw.0")
bazel_dep(name = "ros2_rosidl_typesupport", version = "3.2.3.0.iw.0")
bazel_dep(name = "ros2_rosidl_typesupport_fastrtps", version = "3.6.4.0.iw.2")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# Include numpy headers, which is unconditionally required by all
# ros2_py_interface_library targets.
ADDITIVE_BUILD_CONTENT_NUMPY = """\
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "numpy_lib",
    hdrs = glob(["site-packages/numpy/_core/include/numpy/**/*.h"]),
    includes = ["site-packages/numpy/_core/include/"],
    visibility = ["//visibility:public"],
)
"""

pip.whl_mods(
    additive_build_content = ADDITIVE_BUILD_CONTENT_NUMPY,
    data = [":numpy_lib"],
    hub_name = "rules_ros2_interfaces_whl_mods",
    whl_name = "numpy",
)
use_repo(pip, "rules_ros2_interfaces_whl_mods")

pip.parse(
    extra_hub_aliases = {
        "numpy": ["numpy_lib"],
    },
    hub_name = "rules_ros2_interfaces_pip_deps",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
    target_platforms = [
        "linux_x86_64",
        "linux_aarch64",
    ],
    whl_modifications = {
        "@rules_ros2_interfaces_whl_mods//:numpy.json": "numpy",
    },
)
use_repo(pip, "rules_ros2_interfaces_pip_deps")
