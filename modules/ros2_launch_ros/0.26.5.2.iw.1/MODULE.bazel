module(
    name = "ros2_launch_ros",
    version = "0.26.5.2.iw.1",
    compatibility_level = 1,
)

bazel_dep(name = "osrf_pycommon", version = "2.1.4.6.iw.1")
bazel_dep(name = "ros2_ament_index", version = "1.8.1.1.iw.1")
bazel_dep(name = "ros2_launch", version = "3.4.2.1.iw.1")
bazel_dep(name = "ros2_rcl_interfaces", version = "2.0.2.1.iw.1")
bazel_dep(name = "ros2_rclpy", version = "7.1.2.2.iw.1")
bazel_dep(name = "ros2cli", version = "0.32.1.3.iw.1")
bazel_dep(name = "rules_python", version = "1.2.0")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "ros2_launch_ros_pip_deps",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "ros2_launch_ros_pip_deps")
